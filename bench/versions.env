# Pinned versions for `make bench-compare` — the single source of truth (the results doc
# surfaces these). Override any value in your environment to bump a pin.
#
# redis-benchmark ships inside REDIS_IMAGE (reused; no separate pin).
# cachemoney version is `git describe --tags --always --dirty` at run time.
REDIS_IMAGE=redis:7.4
VALKEY_IMAGE=valkey/valkey:8.1
MEMTIER_IMAGE=redislabs/memtier_benchmark:2.1.1
# pogocache: confirm the exact published image:tag on first run, then pin it here.
POGOCACHE_IMAGE=tidwall/pogocache:latest
